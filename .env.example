# HTTP listen port
PORT=8080

# Redis/Valkey connection URL
REDIS_URL="redis://:materiaq_redis_password@localhost:6379"

# Valkey password used by docker-compose (must match the password in REDIS_URL)
# Generate with: openssl rand -hex 32
VALKEY_PASSWORD="materiaq_redis_password"

# Admin token for /readyz (min 12 chars)
# Generate with: openssl rand -hex 32
ADMIN_TOKEN="your_super_secret_token_here"

# HMAC secret for signing user identities (min 12 chars)
# Generate with: openssl rand -hex 32
HMAC_SECRET="your_super_secret_token_here"

# Serve OpenAPI docs at /docs (true in development, false in production)
ENABLE_DOCS="false"

# Set the Secure flag on the web auth cookie (disable only for local HTTP)
COOKIE_SECURE="true"

# Maximum distinct identities minted per IP per 24 hours (default: 100)
IDENTITY_CAP_PER_IP=100

# HTTP request timeout in seconds (default: 15)
REQUEST_TIMEOUT_SECS=15